# -----------------------------------------------------------------------------
# Core server settings
# -----------------------------------------------------------------------------
PORT=3000
ENABLE_CORS=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# -----------------------------------------------------------------------------
# AWS / LocalStack configuration
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
LOCALSTACK_ENDPOINT=
DYNAMO_ENDPOINT=

# DynamoDB tables & S3 bucket
ENTITIES_TABLE=entities
LISTINGS_TABLE=listings
TASKS_TABLE=tasks
AUDIT_LOG_TABLE=audit_log
ARTIFACTS_BUCKET=archieos-artifacts
INTAKE_EVENTS_TABLE=intake_events

# SQS intake queues
INTAKE_QUEUE_NAME=intake-queue
INTAKE_DLQ_NAME=intake-queue-dlq
INTAKE_QUEUE_URL=

# Rate limit configuration (see src/plugins/simpleRateLimit.ts)
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=60 seconds

# -----------------------------------------------------------------------------
# LLM configuration
# -----------------------------------------------------------------------------
USE_LLM_CLASSIFIER=false
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_MAX_RETRIES=2
LLM_STREAM=false
LLM_CONFIDENCE_MIN=0.6
LLM_TIMEOUT_MS=6000

# CloudFront (optional for signed URLs)
USE_CLOUDFRONT=false
CF_DISTRIBUTION_DOMAIN=
CF_KEY_PAIR_ID=
CF_PRIVATE_KEY_B64=

# -----------------------------------------------------------------------------
# Auth / debug tooling
# -----------------------------------------------------------------------------
ALLOW_DEBUG_USER=false
OIDC_ISSUER=
OIDC_AUDIENCE=
COGNITO_ISSUER=
COGNITO_AUDIENCE=

# -----------------------------------------------------------------------------
# Slack App credentials
# -----------------------------------------------------------------------------
SLACK_APP_ID=
SLACK_BYPASS_VERIFY=false
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_VERIFICATION_TOKEN=

# -----------------------------------------------------------------------------
# Miscellaneous
# -----------------------------------------------------------------------------
ENABLE_DOCS=false
TASK_DEFINITIONS_DIR=./config/task-definitions
