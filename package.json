{
  "name": "archieos-backend",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "_moduleAliases": {
    "@routes": "dist/routes",
    "@db": "dist/db",
    "@services": "dist/services",
    "@plugins": "dist/plugins"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts,js --exec ts-node src/app.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:bootstrap": "ts-node scripts/bootstrap-localstack-ddb.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "vitest run -t 'E2E Flow'",
    "openapi": "node -e \"console.log(JSON.stringify(require('./dist/openapi.js').buildOpenApiSpec()))\" > openapi.json",
    "infra:up": "docker compose up -d localstack",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f localstack",
    "infra:init": "NODE_ENV=local ts-node scripts/infra-init.ts",
    "infra:verify": "NODE_ENV=local ts-node scripts/infra-verify.ts",
    "start:local": "./scripts/start-local.sh",
    "seed": "NODE_ENV=local ts-node scripts/seed.ts",
    "seed:from-fe": "NODE_ENV=local ts-node --transpile-only scripts/seed-from-frontend.ts",
    "seed:reset": "NODE_ENV=local ts-node scripts/seed-reset.ts",
    "docker:build": "docker build -t archieos-app .",
    "docker:up": "docker compose -f docker-compose.yml -f docker-compose.override.yml up -d --build",
    "docker:down": "docker compose down -v"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Operations Center Backend (Node 20 + Fastify + Vitest + LocalStack)",
  "engines": {
    "node": ">=20 <21"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.896.0",
    "@aws-sdk/client-dynamodb": "^3.896.0",
    "@aws-sdk/client-s3": "^3.896.0",
    "@aws-sdk/client-sns": "^3.896.0",
    "@aws-sdk/client-sqs": "^3.896.0",
    "@aws-sdk/cloudfront-signer": "^3.893.0",
    "@aws-sdk/lib-dynamodb": "^3.896.0",
    "@aws-sdk/s3-request-presigner": "^3.896.0",
    "@fastify/compress": "^6.5.0",
    "@fastify/cors": "^8.5.0",
    "@fastify/jwt": "^9.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "aws-xray-sdk-core": "^3.5.3",
    "dotenv": "^17.2.2",
    "fastify": "^4.28.1",
    "fastify-plugin": "^5.0.1",
    "jose": "^5.8.0",
    "module-alias": "^2.2.3",
    "node-fetch": "^3.3.2",
    "openai": "^4.56.0",
    "pino-std-serializers": "^7.0.0",
    "prom-client": "^15.1.3",
    "ulid": "^3.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.152",
    "@types/node": "^20.14.10",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  }
}
